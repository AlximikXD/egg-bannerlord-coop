# Copy to .env, compose loads it automatically. Only STEAM_USERNAME is required.
# Pelican uses panel variables instead, not this file.

# A Steam account that owns Mount & Blade II: Bannerlord. Required - the
# workshop item cannot be downloaded anonymously.
STEAM_USERNAME=

# Optional. Left empty, steamcmd prompts for it on the console instead.
# Either way the first login needs a Steam Guard approval on your phone.
STEAM_PASSWORD=

# 0 = never contact Steam, boot whatever is already downloaded.
#AUTO_UPDATE=1

# Extra workshop item ids to load beside the Coop mod, loaded in this order after
# it. Each needs a Win64_Shipping_Server build, and every player needs the same
# mods at the same versions. See "Mods" in the README.
#WORKSHOP_MODS=

# World to host. A missing save is created from default_new_game.sav.
#SAVE_NAME=saveauto1

# Password joining players are prompted for. Empty means open.
#SERVER_PASSWORD=

# Minutes between world autosaves. 0 disables them.
#AUTOSAVE_MINUTES=5
